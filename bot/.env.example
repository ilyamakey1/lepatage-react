# Скопировать в bot/.env и заполнить. Сервис не стартует без обязательных значений.

# --- сервис ---
BOT_PORT=3003
# Состояние бота (переписка, черновики) — отдельная база. По умолчанию bot/.data/bot.db
BOT_DB_URL=
# База сайта, только чтение. По умолчанию ../database/lepatage.db относительно bot/
CATALOG_DB_URL=

# --- Instagram (Meta-приложение, Instagram API with Instagram Login) ---
# App Secret приложения: им проверяется подпись X-Hub-Signature-256
IG_APP_SECRET=
# Любая случайная строка; та же вводится в кабинете Meta при подписке на webhook
IG_VERIFY_TOKEN=
# Токен Instagram-аккаунта с правами instagram_business_basic, instagram_business_manage_messages
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v23.0

# --- служебный Telegram-бот владельца ---
# Токен от @BotFather
TG_BOT_TOKEN=
# chat_id владельца (и других админов через запятую). Апдейты от остальных игнорируются
TG_ADMIN_CHAT_IDS=
# webhook на сервере, polling — для локальной разработки
TG_MODE=webhook
# Обязателен при webhook: A-Z a-z 0-9 _ - (openssl rand -hex 32)
TG_WEBHOOK_SECRET=
# Если задан — бот сам вызовет setWebhook при старте
TG_WEBHOOK_URL=https://lepatage.com/webhooks/telegram-admin

# --- Hermes Agent ---
HERMES_API_URL=http://127.0.0.1:8642/v1
# = API_SERVER_KEY из ~/.hermes/.env
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
