# Фрагмент ~/.hermes/.env пользователя Hermes на VPS.

# OpenAI-совместимый API-сервер Hermes на 127.0.0.1:8642 (наружу не публиковать).
API_SERVER_ENABLED=true
# Длинный случайный ключ: openssl rand -hex 32. Тот же ключ — в bot/.env как HERMES_API_KEY.
API_SERVER_KEY=

# Ключ провайдера модели — один, в зависимости от выбранного в `hermes setup`, например:
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
