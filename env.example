# --- База данных ---
# Локально: файл в репозитории
DATABASE_URL="file:./database/lepatage.db"
# Fly.io с томом: file:/data/lepatage.db (см. fly.toml и FLY.md)
# Turso: https://xxx.turso.io + DATABASE_AUTH_TOKEN
DATABASE_AUTH_TOKEN=""

# --- Сервер ---
PORT=3001
NODE_ENV=development

# Обязателен в production (генерируйте: openssl rand -base64 48)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# В production обязателен список разрешённых Origin через запятую (браузерный Origin, не путь API)
# Пример: https://your-app.fly.dev,https://www.yourdomain.com
# Для dev (Vite + отдельный порт API) сервер обычно с NODE_ENV=development и CORS не требуется
CORS_ORIGINS=

# Frontend (Vite) — при необходимости переопределить API в dev
VITE_API_URL=

# Домен (для старых скриптов деплоя)
DOMAIN=yourdomain.com

# Email (уведомления)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
